{
    "name": "skedway-api",
    "version": "1.0.0",
    "description": "API for meeting room reservations.",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
        "build": "tsc",
        "test": "jest",
        "seed": "ts-node src/database/run-seeders.ts"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "@controllers/(.*)": "<rootDir>/src/modules/rooms/controllers/$1",
            "@services/(.*)": "<rootDir>/src/modules/rooms/services/$1",
            "@routes/(.*)": "<rootDir>/src/modules/rooms/routes/$1"
        }
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.2.1",
        "drizzle-orm": "^0.44.5",
        "express": "^4.21.2",
        "mysql2": "^3.14.3",
        "uuid": "^11.1.0",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.9",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.11.24",
        "@types/uuid": "^10.0.0",
        "bcryptjs": "^3.0.2",
        "drizzle-kit": "^0.31.4",
        "jest": "^30.1.1",
        "jsonwebtoken": "^9.0.2",
        "nodemon": "^3.1.0",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.3.3"
    }
}